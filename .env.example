# Frontend Configuration
VITE_API_URL=http://localhost:5000/api

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (comma-separated origins or * for all in dev)
CORS_ORIGIN=*

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_16_chars_long

# MongoDB Persistence (Optional for local dev, in-memory fallback is automatically used if omitted)
MONGODB_URI=mongodb://localhost:27017/codereview-ai

# AI Provider (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Code Execution Engine (Judge0)
JUDGE0_BASE_URL=https://ce.judge0.com

# Request Limits
MAX_CODE_LENGTH=50000
MAX_QUESTION_LENGTH=2000
MAX_STDIN_LENGTH=10000
MAX_TEST_CASES=15
